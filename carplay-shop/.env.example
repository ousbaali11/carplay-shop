# --- Base de données ---
# Postgres gratuit : https://supabase.com ou https://neon.tech
# Sur Supabase, clique sur "Connect" → onglet "ORM" pour récupérer ces deux URLs.
# DATABASE_URL : pooler en mode transaction (port 6543) — utilisée par le site en fonctionnement normal.
DATABASE_URL="postgresql://postgres.xxxxx:TON_MOT_DE_PASSE@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL : pooler en mode session (port 5432) — utilisée uniquement par Prisma pour créer/modifier les tables.
DIRECT_URL="postgresql://postgres.xxxxx:TON_MOT_DE_PASSE@aws-0-eu-west-1.pooler.supabase.com:5432/postgres"

# --- Authentification (comptes admin + client) ---
# Génère une valeur aléatoire avec: openssl rand -base64 32
# Doit rester en variable d'environnement (jamais en base) : c'est ce qui signe les
# sessions de connexion, y compris celle de l'admin qui gérerait cette base.
NEXTAUTH_SECRET="remplace-moi-par-une-valeur-aleatoire-longue"
NEXTAUTH_URL="http://localhost:3000"

# --- Adresse publique du site (utilisée dans les emails et redirections de paiement) ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Tout le reste (Stripe, PayPal, Resend, société, contact) se configure
# désormais depuis /admin/integrations et /admin/parametres une fois le site lancé.
# Il n'y a plus rien d'autre à mettre ici.
