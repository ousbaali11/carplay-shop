// Schéma de la base de données.
// Une seule base Postgres, utilisée en local ET en production (voir README, section "Tester en local").
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  CLIENT
}

enum Formula {
  FILES_ONLY    // Formule 1 : fichiers seuls, envoyés par email
  PHYSICAL_CARD // Formule 2 : carte mémoire envoyée par la poste + PDF par email
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PREPARING
  SHIPPED
  COMPLETED
  CANCELED
  REFUNDED
}

enum PaymentMethod {
  STRIPE
  PAYPAL
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  phone        String?
  role         Role     @default(CLIENT)
  createdAt    DateTime @default(now())
  orders       Order[]

  // "Mot de passe oublié" : token temporaire envoyé par email, à usage unique.
  resetToken       String?   @unique
  resetTokenExpiry DateTime?
}

// Réglages globaux du site (une seule ligne, id fixe "singleton").
// Tout ce qui concerne l'encaissement des paiements, séparé du reste des réglages
// du site pour rester une table propre et ciblée.
model PaymentSettings {
  id            String  @id @default("singleton")
  stripeEnabled Boolean @default(true)
  paypalEnabled Boolean @default(true)

  stripeSecretKey     String?
  stripeWebhookSecret String?

  paypalClientId     String?
  paypalClientSecret String?
  paypalEnv          String  @default("sandbox") // "sandbox" ou "live"

  updatedAt DateTime @updatedAt
}

// Tout le reste des réglages du site : contact, identité visuelle, vidéo
// d'accueil, email transactionnel, infos société pour les factures.
model SiteSettings {
  id           String @id @default("singleton")
  contactEmail String @default("contact@tondomaine.fr")
  instagramUrl String @default("https://instagram.com/tapage")
  whatsappUrl  String?

  // Si false : aucune facture n'est générée ni jointe par email, et le lien
  // "Facture" disparaît de l'espace client et de la page de téléchargement.
  // L'admin garde quand même accès à la facture depuis /admin/commandes/[id].
  invoicesEnabled Boolean @default(true)

  // Identité visuelle (logo + nom), modifiable par l'admin. Si logoUrl est vide,
  // un logo par défaut (SVG intégré) est utilisé à la place.
  siteName String  @default("CarPlayActiv")
  logoUrl  String?
  // Hauteur d'affichage du logo, en pixels (largeur automatique, proportionnelle).
  logoHeight Int @default(38)

  // Vidéo de la page d'accueil (à la place de l'animation par défaut).
  heroVideoUrl String?

  // Resend (email transactionnel)
  resendApiKey           String?
  emailFrom               String  @default("commandes@tondomaine.fr")
  adminNotificationEmail   String?

  // Infos affichées sur les factures générées automatiquement
  companyName    String  @default("CarPlayActiv")
  companyAddress String?

  updatedAt DateTime @updatedAt
}

// Une fiche par véhicule. Les photos sont communes aux deux formules ; les PDF et
// les fichiers d'activation sont séparés par formule car les étapes et les fichiers
// eux-mêmes diffèrent entre "fichiers seuls" et "carte physique".
model Vehicle {
  id          String  @id @default(cuid())
  brand       String
  model       String
  year        String
  description String?

  priceFilesCents    Int
  pricePhysicalCents Int

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  images          VehicleImage[]
  pdfs            VehiclePdf[]
  // Liens externes (ex: Google Drive) vers les fichiers d'activation — pour la
  // formule "fichiers seuls" uniquement. La formule "carte physique" n'a besoin
  // d'aucun lien : la carte est préparée entièrement en interne.
  activationLinks VehicleActivationLink[]

  // Type d'activation partagé entre véhicules (ex: "MST2 Volkswagen Delphi").
  // Ses PDF sont communs aux deux formules et envoyés en plus des fichiers
  // propres à chaque véhicule. Optionnel : une fiche véhicule peut n'en avoir aucun.
  activationTypeId String?
  activationType    ActivationType? @relation(fields: [activationTypeId], references: [id], onDelete: SetNull)

  orders          Order[]

  @@index([brand, model])
}

model VehicleActivationLink {
  id        String   @id @default(cuid())
  vehicleId String
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  url       String
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([vehicleId])
}

// Bibliothèque de guides d'activation réutilisables (ex: "MST2 Volkswagen Delphi").
// Une fiche véhicule peut en sélectionner un ; ses PDF sont alors envoyés en plus
// des fichiers propres au véhicule, pour les deux formules.
model ActivationType {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  pdfs     ActivationTypePdf[]
  vehicles Vehicle[]
}

model ActivationTypePdf {
  id               String         @id @default(cuid())
  activationTypeId String
  activationType   ActivationType @relation(fields: [activationTypeId], references: [id], onDelete: Cascade)
  data             Bytes
  fileName         String
  position         Int            @default(0)
  createdAt        DateTime       @default(now())

  @@index([activationTypeId])
}

model VehicleImage {
  id        String   @id @default(cuid())
  vehicleId String
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  data      Bytes
  mimeType  String
  fileName  String?
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([vehicleId])
}

model VehiclePdf {
  id        String   @id @default(cuid())
  vehicleId String
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  formula   Formula
  data      Bytes
  fileName  String
  title     String?
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([vehicleId])
  @@index([vehicleId, formula])
}

// Fichier(s) d'activation bootables, séparés par formule :
// - FILES_ONLY     : livrés directement au client après paiement
// - PHYSICAL_CARD  : jamais livrés au client, utilisés en interne par l'admin
//                    pour préparer la carte mémoire physique à expédier
model Order {
  id          String  @id @default(cuid())
  orderNumber String  @unique
  user        User?   @relation(fields: [userId], references: [id])
  userId      String?

  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  vehicleId String?

  vehicleBrand String
  vehicleModel String
  vehicleYear  String

  formula    Formula
  priceCents Int

  status        OrderStatus    @default(PENDING_PAYMENT)
  paymentMethod PaymentMethod?
  paymentRef    String?

  email       String
  firstName   String
  lastName    String
  phone       String
  address     String?
  addressComp String?
  postalCode  String?
  city        String?
  country     String  @default("France")

  trackingNumber String?
  shippedAt      DateTime?

  // Copies figées au moment du paiement : c'est CE contenu qui est livré au client,
  // jamais le contenu "live" de la fiche véhicule (qui peut changer ensuite).
  pdfs OrderPdf[]

  // Liens d'activation livrés au client (formule FILES_ONLY uniquement), figés
  // au paiement. Chacun est à usage unique.
  activationLinks OrderActivationLink[]

  downloadToken     String?   @unique
  downloadExpiresAt DateTime?
  downloadCount     Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OrderActivationLink {
  id       String    @id @default(cuid())
  orderId  String
  order    Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  url      String
  position Int       @default(0)
  used     Boolean   @default(false)
  usedAt   DateTime?

  @@index([orderId])
}

model OrderPdf {
  id       String  @id @default(cuid())
  orderId  String
  order    Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  data     Bytes
  fileName String
  title    String?
  position Int     @default(0)

  // À usage unique lui aussi : un PDF déjà téléchargé une fois ne peut plus
  // l'être une seconde fois (anti-fraude).
  downloaded   Boolean   @default(false)
  downloadedAt DateTime?

  @@index([orderId])
}